DATABASE_DIR=/path/to/db/dir
DATABASE_POOL_SIZE=4
# Set to 2 to enable the job worker pool; 0 disables it.
JOB_WORKERS=0
JWT_SECRET=change-me
NOTES_MASTER_KEY="base64-encoded-master-key"
UPLOAD_DIR=/path/to/upload_dir
SERVER_ADDRESS=127.0.0.1:11001
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_REGION=us-east-1
AWS_S3_BUCKET=bucket-name
AUTH_API_BASE_URL=https://yaas-flashy-domain.com
